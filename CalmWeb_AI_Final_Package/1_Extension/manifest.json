{
  "manifest_version": 3,
  "name": "CalmWeb AI",
  "short_name": "CalmWeb",
  "version": "3.1.0",
  "description": "A calmer, more focused web for learning. An AI model blocks pop-ups, plus reading comfort tools and on-device page summaries.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CalmWeb AI",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ad_blocking",
        "enabled": true,
        "path": "rules/ad_rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/popup-guard.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/settings.js",
        "content/protect.js",
        "content/ai-model.js",
        "content/blocker.js",
        "content/reading.js",
        "content/summarizer.js",
        "content/simplifier.js",
        "content/main.js"
      ],
      "css": [
        "content/page.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*",
        "models/*"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}